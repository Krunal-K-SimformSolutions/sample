{
  "name": "NewProject",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "first-pod-install": "cd ios && bundle install && cd ..",
    "next-pod-install": "cd ios && bundle exec pod install && cd ..",
    "start": "react-native start",
    "android:dev": "npx react-native run-android --mode developmentdebug",
    "android:stage": "npx react-native run-android --mode stagingdebug",
    "android:prod": "npx react-native run-android --mode productiondebug",
    "ios:dev": "npx react-native run-ios --scheme NewProject-Development",
    "ios:stage": "npx react-native run-ios --scheme NewProject-Staging",
    "ios:prod": "npx react-native run-ios --scheme NewProject",
    "test": "yarn jest --coverage --config=jest.config.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretty": "prettier --write '**/*.{js,jsx,ts,tsx,md,json}'",
    "types": "tsc --noEmit",
    "spelling": "cspell lint '**/*.{js,jsx,ts,tsx,md,json}'",
    "local:check": "yarn lint && yarn lint:fix && yarn pretty && yarn types && yarn spelling",
    "android:dev-release": "npx react-native run-android --mode developmentrelease",
    "android:stage-release": "npx react-native run-android --mode stagingrelease",
    "android:prod-release": "npx react-native run-android --mode productionrelease",
    "ios:dev-release": "npx react-native run-ios --scheme NewProject-Development --mode Release",
    "ios:stage-release": "npx react-native run-ios --scheme NewProject-Staging --mode Release",
    "ios:prod-release": "npx react-native run-ios --scheme NewProject --mode Release",
    "generate:strings": "node scripts/generateStringConst.ts false",
    "generate:files": "node scripts/generateFiles.ts",
    "generate:icons": "node scripts/convertSVGtoComponent.ts",
    "generate:targets": "cd ios && bundle exec ../scripts/duplicateTarget.rb && cd .."
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.83.1",
    "@sentry/react-native": "7.8.0",
    "dayjs": "1.11.19",
    "i18next": "25.7.3",
    "lodash": "4.17.21",
    "react": "19.2.3",
    "react-i18next": "16.5.0",
    "react-native": "0.83.1",
    "react-native-config": "1.6.1",
    "react-native-localize": "3.6.1",
    "react-native-mmkv": "4.1.0",
    "react-native-nitro-modules": "0.32.0",
    "react-native-permissions": "5.4.4",
    "react-native-safe-area-context": "5.6.2",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@babel/traverse": "7.28.5",
    "@babel/types": "7.28.5",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@svgr/babel-preset": "8.1.0",
    "@svgr/core": "8.1.0",
    "@svgr/hast-util-to-babel-ast": "8.0.0",
    "@types/babel__traverse": "7.28.0",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.21",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-test-renderer": "19.1.0",
    "@types/svg-parser": "2.0.6",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "commander": "14.0.2",
    "cspell": "9.4.0",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.12.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "5.0.0",
    "fs-extra": "11.3.3",
    "inquirer": "13.1.0",
    "jest": "30.2.0",
    "lefthook": "2.0.13",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "react-test-renderer": "19.2.3",
    "svg-parser": "2.0.4",
    "svgo": "4.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.12.0"
}
